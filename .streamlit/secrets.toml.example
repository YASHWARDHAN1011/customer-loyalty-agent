# Streamlit Cloud secrets template.
# On Streamlit Cloud: paste these into the app's Settings -> Secrets.
# Locally: copy to .streamlit/secrets.toml (gitignored) OR keep using a .env.
# config.py reads st.secrets first, then falls back to os.getenv (.env).

# --- Gemini (required) ---
# Add as many keys as you have (GEMINI_KEY_1 .. GEMINI_KEY_10); each key x model
# is a separate free-tier quota bucket, so more keys = more headroom. At least
# GEMINI_KEY_1 is required for the chat to answer.
GEMINI_KEY_1 = "your-gemini-api-key-here"
# GEMINI_KEY_2 = "second-key-for-more-quota"
# GEMINI_KEY_3 = "..."

# --- Anthropic / Claude (optional) ---
# If set, adds a Claude failover tier: when all Gemini keys are out of quota the
# text/reasoning calls fail over to Claude. Leave unset to run Gemini-only.
# ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
